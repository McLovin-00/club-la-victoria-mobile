# ============================================
# Club La Victoria - Mobile App
# Variables de Entorno
# ============================================

# INSTRUCCIONES:
# 1. Copiar este archivo como .env
# 2. Reemplazar los valores con los de tu entorno
# 3. NUNCA subir el archivo .env al repositorio

# ============================================
# API REST - Backend
# ============================================

# URL base del API REST (incluir /api/v1 al final)
# Desarrollo local: http://192.168.x.x:3001/api/v1
# Servidor remoto: https://api.clublavictoria.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# ============================================
# Socket.IO - WebSocket Server
# ============================================

# URL del servidor Socket.IO (sin /api/v1, solo host:port)
# Debe coincidir con la URL del backend pero SIN el path /api/v1
# Desarrollo local: http://192.168.x.x:3001/
# Servidor remoto: https://api.clublavictoria.com/
EXPO_PUBLIC_SOCKETIO_URI=http://localhost:3001/

# ============================================
# NOTAS IMPORTANTES
# ============================================

# Para desarrollo en dispositivo físico (no emulador):
# - Reemplazar 'localhost' con la IP local de tu computadora
# - Ejemplo: EXPO_PUBLIC_API_URL=http://192.168.1.100:3001/api/v1
# - Asegúrate que el dispositivo esté en la misma red WiFi

# Para obtener tu IP local:
# - Windows: ipconfig (buscar IPv4)
# - Mac/Linux: ifconfig (buscar inet)

# Para producción:
# - Usar HTTPS siempre
# - Configurar SSL/TLS en el backend
# - Usar dominio propio en lugar de IP
